# Скопируйте в .env и при необходимости отредактируйте

# Режим: 1 = mock (звонок имитируется кнопкой), 0 = реальный Plusofon
MOCK=1

# API-ключ для доступа к /api/verify/* (заголовок X-Api-Key). Пусто = без проверки.
API_KEY=dev-key-change-me

# Публичный HTTPS/HTTP-адрес, доступный снаружи (используется для hook_url при MOCK=0).
# Пример для сервера с прямым доменом: http://merch-vibe.ru:3000
PUBLIC_BASE_URL=https://merch-vibe.ru:4443

# Время жизни верификации, сек (30–300)
CALL_TTL=180

# --- Plusofon (нужны только при MOCK=0) ---
# Основной токен ЛК Plusofon (ЛК -> Разработчики -> Доступ к API) — для scripts/setup_flashcall.py
PLUSOFON_LK_TOKEN=

# access_token аккаунта Flash Call: POST https://restapi.plusofon.ru/api/v1/flash-call
# с основным токеном ЛК (ЛК -> Разработчикам -> Доступ к API)
PLUSOFON_FC_ACCOUNT_TOKEN=

# Allowlist IP вебхука (по документации — 185.54.48.1). Пусто = отключить проверку.
WEBHOOK_IPS=185.54.48.1

# Фиктивный номер для показа в mock-режиме
MOCK_CALL_NUMBER=88003330999

# --- Keycloak ---
KC_VERSION=26.3
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Для cloudflared (вариант 2, именованный туннель)
# CLOUDFLARED_TOKEN=
